{
  "name": "telegram-bot-panel-v2",
  "version": "3.6.0",
  "private": true,
  "type": "module",
  "description": "پنل چندمنظوره دو زبانه ربات تلگرام روی Cloudflare Workers و Durable Objects (SQLite)",
  "scripts": {
    "dev": "npm run build && wrangler dev --ip 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "tail": "wrangler tail",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/panel-screenshots.mjs",
    "build": "node scripts/build-panel.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node tests/browser.mjs",
    "test:services-ui": "node tests/services-browser.mjs",
    "test:workerd-services": "node tests/workerd-services.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "hono": "^4.13.7",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "jsdom": "^30.0.1",
    "@playwright/test": "^1.63.0",
    "lucide": "^0.468.0",
    "tailwindcss": "^3.4.19",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=22.16"
  }
}
